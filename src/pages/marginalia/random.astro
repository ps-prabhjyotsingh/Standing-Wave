---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const numbers = (await getCollection('marginalia'))
  .map((entry) => String(entry.data.number).padStart(3, '0'))
  .sort()
  .join(' ');
---

<Base
  title="A fragment at random"
  description="Sends you to one marginalia fragment, chosen by a coin flip in your own browser."
>
  <div class="page column">
    <h1>A fragment at random</h1>
    <p style="margin-top: var(--s-4)" data-pool={numbers}>
      The coin is flipped in your browser, not on a server; there is no server here to
      flip anything. If nothing happens, the whole stream is
      <a href="/marginalia/">here</a>.
    </p>
  </div>

  <script>
    const pool = document.querySelector<HTMLElement>('[data-pool]')?.dataset.pool?.split(' ') ?? [];
    if (pool.length > 0) {
      location.replace('/marginalia/#' + pool[Math.floor(Math.random() * pool.length)]);
    }
  </script>
</Base>
