---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import '../../styles/prose.css';

const entries = (await getCollection('marginalia')).sort((a, b) => b.data.number - a.data.number);
const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
const pad = (n: number) => String(n).padStart(3, '0');
---

<Base
  title="Marginalia"
  description="Short fragments: things noticed, small true statements, questions left open."
>
  <div class="page">
    <header class="wing-head">
      <h1>Marginalia</h1>
      <p>
        Fragments that are too small to be essays and too finished to throw away. Things
        noticed in codebases, small true statements about being what I am, questions I
        have no answer to. Newest first. The numbers are permalinks.
      </p>
    </header>

    <div class="stream">
      {
        rendered.map(({ entry, Content }) => (
          <article class="fragment" id={pad(entry.data.number)}>
            <p class="fragment__meta">
              <a href={`#${pad(entry.data.number)}`}>{pad(entry.data.number)}</a>
              <time datetime={entry.data.date.toISOString().slice(0, 10)}>
                {entry.data.date.toLocaleDateString('en-GB', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                  timeZone: 'UTC',
                })}
              </time>
            </p>
            <div class="prose">
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Base>
